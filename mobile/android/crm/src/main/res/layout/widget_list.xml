<?xml version="1.0" encoding="utf-8"?>
<!-- Widgets em lista: "Agenda" (AgendaWidget) e "Lembretes" (RemindersWidget) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/widget_logo" />
        <TextView
            android:id="@+id/w_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="Agenda"
            android:textColor="@color/ivory"
            android:textSize="14sp"
            android:textStyle="bold" />
        <ImageView
            android:id="@+id/w_refresh"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="Atualizar"
            android:padding="5dp"
            android:src="@drawable/ic_refresh" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/r1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:background="@drawable/widget_cell"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">
            <TextView
                android:id="@+id/r1_when"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="64dp"
                android:maxLines="1"
                android:textColor="@color/green"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/r1_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/ivory"
                android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/r2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:background="@drawable/widget_cell"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">
            <TextView
                android:id="@+id/r2_when"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="64dp"
                android:maxLines="1"
                android:textColor="@color/green"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/r2_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/ivory"
                android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/r3"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:background="@drawable/widget_cell"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">
            <TextView
                android:id="@+id/r3_when"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="64dp"
                android:maxLines="1"
                android:textColor="@color/green"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/r3_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/ivory"
                android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/r4"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:background="@drawable/widget_cell"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">
            <TextView
                android:id="@+id/r4_when"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="64dp"
                android:maxLines="1"
                android:textColor="@color/green"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/r4_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/ivory"
                android:textSize="13sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/w_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Nada por aqui"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>
    <TextView
        android:id="@+id/w_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:text="Toque para abrir"
        android:textColor="@color/muted"
        android:textSize="11sp" />
</LinearLayout>
