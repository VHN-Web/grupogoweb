<?xml version="1.0" encoding="utf-8"?>
<!-- Tela cheia "Nova entrega" (IncomingActivity) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginTop="16dp"
        android:contentDescription="@null"
        android:src="@mipmap/ic_launcher" />

    <TextView
        android:id="@+id/offer_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="@color/ivory"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/offer_store"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/muted"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/offer_fee"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/green"
            android:textSize="48sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/offer_km"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/ivory"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- bairro em destaque: o motoboy já sabe para que lado vai -->
        <TextView
            android:id="@+id/offer_bairro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="@color/green"
            android:textSize="24sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/offer_addr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card"
            android:gravity="center"
            android:maxLines="4"
            android:padding="16dp"
            android:textColor="@color/ivory"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/offer_msg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="@color/amber"
            android:textSize="17sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/offer_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/ivory"
        android:textSize="22sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/offer_bar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="20dp"
        android:progressDrawable="@drawable/countdown" />

    <Button
        android:id="@+id/offer_accept"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@drawable/btn_accept"
        android:textAllCaps="false"
        android:textColor="@color/bg"
        android:textSize="22sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/offer_decline"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/btn_decline"
        android:textAllCaps="false"
        android:textColor="@color/ivory"
        android:textSize="17sp" />
</LinearLayout>
