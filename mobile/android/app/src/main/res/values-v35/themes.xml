<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Android 15: mantém barras de sistema fora do site (o WebView não recebe safe-area). -->
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorPrimary">@color/bg</item>
        <item name="android:colorAccent">@color/green</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- o modo escuro "forçado" de alguns celulares (Samsung/Xiaomi) escurece o site e deixa letra escura em fundo escuro: o próprio site já tem tema escuro -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
