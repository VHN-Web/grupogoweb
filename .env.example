# Banco de dados
# - Vazio / ausente: usa PGlite (PostgreSQL embutido, pasta ./.pglite). Ideal para desenvolver.
# - Produção: postgres://usuario:senha@host:5432/db  (Neon, Supabase, Railway...)
DATABASE_URL=""

# Segredo para assinar a sessão do painel (gere um: openssl rand -hex 32)
SESSION_SECRET="troque-isto-por-um-segredo-longo-e-aleatorio"

# URL pública da plataforma (usada nos QR Codes e callbacks dos gateways)
APP_URL="http://localhost:3000"

# Senha do super-admin da plataforma (criar/gerenciar estabelecimentos em /admin)
PLATFORM_ADMIN_PASSWORD="admin123"

# --- Gateways (preencher quando os adapters reais forem implementados) ---
BANCARD_PUBLIC_KEY=""
BANCARD_PRIVATE_KEY=""
BANCARD_ENV="staging"
PAGOPAR_PUBLIC_KEY=""
PAGOPAR_PRIVATE_KEY=""

# --- SIFEN (Facturación Electrónica - DNIT) ---
SIFEN_ENV="test"

# Habilita o gateway simulado em produção (somente para demos)
ENABLE_MOCK_GATEWAY="false"

# --- Cobrança dos SEUS clientes (plataforma) ---
# Mercado Pago (conta BR, cobra em BRL). Use credenciais de TESTE primeiro.
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""
# PayPal (USD) e Pagopar (PYG): adapters preparados, ainda não implementados
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""

# Cron diário de cobrança (/api/cron/billing). Na Vercel é enviado automaticamente.
CRON_SECRET="troque-por-um-segredo"

# --- Notificações ---
# E-mail via Resend (https://resend.com). Sem chave = só registra no admin.
RESEND_API_KEY=""
EMAIL_FROM="Atlas <cobranca@seudominio.com>"
# WhatsApp: URL da sua API (Evolution, Z-API, n8n...). Recebe POST {to, message}. Sem URL = só registra.
WHATSAPP_WEBHOOK_URL=""
WHATSAPP_WEBHOOK_TOKEN=""

# --- Imagens (logo, banner, fotos) ---
# Na Vercel: Storage > Blob cria esta variável automaticamente. Sem ela, salva em .uploads/
BLOB_READ_WRITE_TOKEN=""
